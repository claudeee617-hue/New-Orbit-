{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "orbit-cloud-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbit-cloud",
      "database_id": "6ce29c73-2173-40ee-adb2-d98adbcf762d",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://summer-recipe-870a.cloudflareaccess.com",
    "ACCESS_AUD": "e66cd770b0c5c3a31317bbdcaf274d0d522457a74651df990635ccc3121206e8",
  },
}
