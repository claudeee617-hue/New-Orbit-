{
  "name": "@orbit/mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Read-only Model Context Protocol server for ORBIT repository intelligence.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --testTimeout=30000",
    "test:stdio": "node --test scripts/stdio.integration.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@orbit/atlas": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/database": "workspace:*",
    "@orbit/graph": "workspace:*",
    "@orbit/shared": "workspace:*",
    "zod": "4.6.7"
  }
}
