{
  "name": "@orbit/witness",
  "version": "0.0.1",
  "private": true,
  "description": "WITNESS: evidence-based pull-request verification. Maps a Git diff to symbols, coverage, tests and findings.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@orbit/atlas": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/database": "workspace:*",
    "@orbit/graph": "workspace:*",
    "@orbit/shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0"
  }
}
