{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ORBIT WITNESS",
          "version": "0.1.0",
          "rules": [
            {
              "id": "COVERAGE-REGRESSION",
              "name": "COVERAGE-REGRESSION",
              "shortDescription": {
                "text": "Coverage of src/math.ts dropped from 100.0% to 62.5%"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "NO-COVERAGE",
              "name": "NO-COVERAGE",
              "shortDescription": {
                "text": "No coverage data for changed file"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "NO-RELATED-TEST",
              "name": "NO-RELATED-TEST",
              "shortDescription": {
                "text": "No test directly linked to src/auth.ts"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SENSITIVE-FILE",
              "name": "SENSITIVE-FILE",
              "shortDescription": {
                "text": "Sensitive file changed"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "TEST-FAILURE",
              "name": "TEST-FAILURE",
              "shortDescription": {
                "text": "Test failed"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "TEST-REGRESSION",
              "name": "TEST-REGRESSION",
              "shortDescription": {
                "text": "Test passed at base and fails at head"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "UNCOVERED-LINES",
              "name": "UNCOVERED-LINES",
              "shortDescription": {
                "text": "Changed lines not executed by tests"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "UNTESTED-SYMBOL",
              "name": "UNTESTED-SYMBOL",
              "shortDescription": {
                "text": "function mul changed with no executed changed line"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
